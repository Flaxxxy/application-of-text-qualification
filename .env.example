# Copy this file to .env and fill in your keys. .env is git-ignored, never commit it.

# Kaggle: https://www.kaggle.com/settings -> API -> "Create New Token".
# Use EITHER the new single token ...
KAGGLE_API_TOKEN=
# ... OR the classic username + key pair (from the downloaded kaggle.json).
KAGGLE_USERNAME=
KAGGLE_KEY=

# Roboflow: https://app.roboflow.com -> Settings -> API Keys -> Private API Key.
ROBOFLOW_API_KEY=
